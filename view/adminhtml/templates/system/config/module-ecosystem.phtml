    foreach ($view->addons as $offerRow) {
        if (!$offerRow->isInstalled() && in_array('pro', $offerRow->tiers, true)) {
            $proOffer[] = $offerRow->moduleName;
            $proOfferNames[] = $offerRow->name;
        }
    }
}
sort($proOffer);
$proOfferCount  = count($proOffer);
$offerSignature = $proOfferCount === 0 ? '' : substr(sha1(implode(',', $proOffer)), 0, 8);

