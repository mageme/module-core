// The renewal link carries the serial, so it belongs to the same ACL as the serial field itself.
// Without it the block below falls back to the plain "Support expired" button.
$renewUrl = $block->canViewLicense() ? $view->renewUrl : null;

// The standing Pro offer: add-ons the merchant does not own yet. Gated on the same CTA the
// header shows, so it can never advertise an upgrade the panel does not offer, and silenced
// once a licence is on file next to an installed Pro module — that merchant has already paid,
// whatever the support window says. The signature keys the collapse memory, so a genuinely
// new add-on earns one fresh showing instead of staying hidden behind an old dismissal.
$hasProInstalled = false;
foreach ($view->addons as $offerRow) {
    if ($offerRow->isInstalled() && in_array('pro', $offerRow->tiers, true)) {
        $hasProInstalled = true;
        break;
    }
}
$hasLicence = $view->license !== null
    && ($view->license->isActive || (string) $view->license->serial !== '');
$offersPro  = $view->getProUrl !== null && !($hasLicence && $hasProInstalled);

$proOffer = [];
$proOfferNames = [];
